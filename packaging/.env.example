# WATERCAST 설치 설정 — install.sh 가 이 파일을 .env 로 복사한다. 값을 바꾸고 ./start.sh 로 재기동.
# 형식: KEY=값. 따옴표는 있어도 되고 없어도 된다. 윈도 편집기(CRLF)로 고쳐도 된다.

# 런타임 이미지 태그 (images/watercast-runtime-*.tar.gz 를 load 한 것과 같아야 한다). 앱 코드는 app/current 에 따로 둔다.
WATERCAST_IMAGE=watercast-runtime:0.2.0
# 컨테이너 이름 접두 (같은 서버에 두 벌 띄우면 바꾼다)
WATERCAST_NAME=watercast

# 호스트 포트 — 다른 서비스와 겹치면 바꾼다
WATERCAST_API_PORT=18000
WATERCAST_UI_PORT=8501
WATERCAST_PIPE_PORT=8502

# 발표용 데모 화면까지 띄우려면 demo, 아니면 비워 둔다
COMPOSE_PROFILES=demo

# [선택] 기상청 공공데이터포털 일반 인증키 — ASOS 과거 관측 수집·단기예보 수집에만 쓴다.
# 비워 두면 묶음에 든 관측 자료(2015~2024)와 수위 예측·탐지는 전부 그대로 동작한다. 우리 API 자체는 인증이 없다.
KMA_API_KEY=

# ── 컨테이너 안에서 탐지 실행 (docker 소켓) ──────────────────────────────────
# compose 가 /var/run/docker.sock 을 API 컨테이너에 넣어 탐지 잡이 wbms:0.13 을 직접 띄운다
# (실탐지 묶음 + ./install.sh --with-wbms 필요. 없으면 캐시된 장면만 답한다).
# 이 패키지 디렉터리의 호스트 절대경로. 비우면 compose 를 실행한 디렉터리(start.sh 가 여기로 cd 한다).
HOST_ROOT=
# 탐지 컨테이너를 돌릴 uid:gid — 산출물(data/wbms_runs/wb) 소유자. 그 디렉터리 소유자와 같아야
# 쓸 수 있으므로 압축을 푼 계정의 `id -u`:`id -g` 로 맞춘다.
RUN_AS=1000:1000
# 탐지 장치: auto(여유 VRAM 3000 MiB 이상이면 GPU 30~60초, 아니면 CPU 10분 내외) | cpu | gpu(부족하면 잡 거절)
WBMS_GPU=auto

# ── 과제 통합 플랫폼 연계 (통합 측이 배정하면 채운다) ──────────────────────
# 알고리즘 로그 API 주소. 비어 있으면 로그를 보내지 않는다.
BACKEND_LIAISON_LOG_URL=
# 수체탐지 시스템 코드·알고리즘 ID (배정 전 자리표시)
BACKEND_LIAISON_SYSTEM_CODE=SC000000
BACKEND_LIAISON_ALGM_ID=AG000000

# 3세부와 공유하는 도커 네트워크에 붙일지 (1 이면 docker-compose.smss-net.yml 오버레이를 덧붙인다. 네트워크가 먼저 있어야 한다)
WITH_SMSS_NET=0
# 그 네트워크 이름
SMSS_NET=smss-net
