# GPU 지원 TensorFlow + Python 3.11 공식 이미지
FROM tensorflow/tensorflow:2.17.0-gpu-jupyter

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# pip 최신화
RUN pip install --upgrade pip

# Python 3.11 환경에 맞춰 ipykernel 최신화 및 필수 패키지 설치
RUN pip install --upgrade ipykernel jupyter jupyterlab ipywidgets

# 추가 패키지 설치
RUN pip install \
    numpy \
    matplotlib \
    imageio \
    keras==3.0.2 \
    ipython \
    pillow \
    geopandas \
    rasterio \
    shapely

# Jupyter 위젯 확장 설치 (실패해도 무시)
RUN jupyter labextension install @jupyter-widgets/jupyterlab-manager --no-build || true
RUN jupyter lab build || true

# 커널을 시스템에 등록 (Python 3.11 경로 기준)
RUN python -m ipykernel install --sys-prefix --name python311 --display-name "Python 3.11"

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=''"]
