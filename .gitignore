# Small, provenance-tracked browser/demo manifests derived from the delivered NAS.
!ui_next/assets/nas/**/*.json

# ICEYE SLC ingest가 만든 데모용 메타데이터 (scripts/iceye_slc_ingest.py)
!pipeline_ui/assets/iceye_meta.json
# pipeline_ui 실모델 패널이 읽는 크롭 메타 (scripts/make_pipeline_ui_wbms_assets.py)
!pipeline_ui/assets/wbms_*_meta.json

# 지역 레지스트리(플랫폼 입력 규약)와 학습 산출물 — 전부 작은 JSON이라 추적한다
!regions/**/*.json
# backend/app 안의 설정 JSON(WBMS 카탈로그 등)
!backend/app/**/*.json

__pycache__/
.pytest_cache/
.ruff_cache/
